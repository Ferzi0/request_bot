# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather, вида 123456789:AAE...  (никому не пересылайте)
BOT_TOKEN=

# Ваш числовой Telegram ID — сюда бот присылает заявки (узнать: @userinfobot).
# Перед первым запуском откройте своего бота и нажмите /start, иначе он не сможет вам написать.
ADMIN_ID=

# Ссылка на политику конфиденциальности сайта. Пока домена нет — оставьте пустым,
# тогда в шаге согласия будет текст без ссылки.
POLICY_URL=

# Контакт для клиента, если заявку не удалось переслать (как на сайте).
FALLBACK_CONTACT=eduardtorgasov894@gmail.com или @ferzV1

# Необязательные (значения по умолчанию):
# TIMEZONE=Asia/Yekaterinburg
# APPLICATIONS_PER_HOUR=3
# NOTIFY_ADMIN_ON_START=true
# LOG_LEVEL=INFO
